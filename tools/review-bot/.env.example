# コピーして tools/review-bot/.env を作る。.env はコミットしない。
# ボットのトークン（Discord Developer Portal の Bot → Reset Token）
DISCORD_BOT_TOKEN=
# レビュー依頼を出すチャンネル（フォーラムかテキスト）の ID
DISCORD_REVIEW_CHANNEL_ID=
# GitHub のログイン名 → Discord のユーザー ID（1行で書く）
DISCORD_MEMBERS={"iuti":"000000000000000000","noriakiumei":"000000000000000000"}
